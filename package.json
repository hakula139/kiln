{
  "private": true,
  "scripts": {
    "check:node": "node --check npm/launcher.cjs && node --check npm/package.mjs",
    "format": "pnpm format:prettier --check && pnpm format:markdown && pnpm format:toml",
    "format:prettier": "prettier \"**/*.{cjs,js,json,mjs,yaml,yml}\"",
    "format:markdown": "dprint check",
    "format:toml": "taplo format --check",
    "lint": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\"",
    "spellcheck": "cspell --no-progress \"**/*\""
  },
  "devDependencies": {
    "@taplo/cli": "^0.7.0",
    "cspell": "^10.3.6",
    "dprint": "^0.60.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9"
  }
}
