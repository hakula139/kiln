{
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "format": "pnpm format:prettier && pnpm format:markdown && pnpm format:toml",
    "format:markdown": "dprint check",
    "format:prettier": "prettier --check \"**/*.json\"",
    "format:toml": "taplo format --check",
    "lint": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\"",
    "spellcheck": "cspell --no-progress \"**/*\""
  },
  "devDependencies": {
    "@taplo/cli": "^0.7.0",
    "cspell": "^10.0.0",
    "dprint": "^0.55.2",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3"
  }
}
