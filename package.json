{
  "private": true,
  "scripts": {
    "format": "pnpm format:prettier && pnpm format:markdown && pnpm format:toml",
    "format:prettier": "prettier --check .",
    "format:markdown": "dprint check",
    "format:toml": "taplo format --check",
    "lint": "markdownlint-cli2 \"**/*.md\"",
    "spellcheck": "git ls-files | cspell --no-progress --file-list stdin"
  },
  "devDependencies": {
    "@taplo/cli": "^0.7.0",
    "cspell": "^10.3.6",
    "dprint": "^0.64.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.9"
  }
}
