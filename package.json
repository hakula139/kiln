{
  "private": true,
  "scripts": {
    "format": "pnpm format:prettier && pnpm format:markdown && pnpm format:toml",
    "format:markdown": "dprint check",
    "format:prettier": "prettier --check \"**/*.{json,cjs,mjs}\" \".github/**/*.{yml,yaml}\"",
    "format:toml": "taplo format --check",
    "lint": "pnpm lint:markdown && pnpm lint:node",
    "lint:markdown": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\"",
    "lint:node": "eslint .",
    "spellcheck": "cspell --no-progress \"**/*\"",
    "test": "node --test npm/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@taplo/cli": "^0.7.0",
    "cspell": "^10.3.6",
    "dprint": "^0.60.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9"
  }
}
