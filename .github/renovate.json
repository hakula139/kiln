{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hakulab/devkit#v3"],
  "packageRules": [
    {
      "matchManagers": ["rust-toolchain"],
      "enabled": false
    },
    {
      "matchPackageNames": ["/^swc_/"],
      "groupName": "swc",
      "separateMajorMinor": false
    }
  ]
}
